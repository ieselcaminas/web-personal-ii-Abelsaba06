{% extends 'base.html.twig' %}

{% block title %}Lista de imágenes{% endblock %}

{% block body %}
<h1>Lista de imágenes</h1>

<table class="table table-striped table-hover table-bordered mx-auto" style="width:90%">
    <thead class="bg-success text-dark text-center">
        <tr >
            <th>ID</th>
            <th>Imagen</th>
            <th>Nombre</th>
        </tr>
    </thead>
    <tbody>
        {% for image in images %}
            <tr class="table-success text-center">
                <td>{{image.id}}</td>
                <td>
                    {% if image.file %}
                        <img src="{{ asset('images/index/gallery/' ~ image.file) }}" alt="{{ image.file }}" style="height: 100px;" class="img-fluid d-block mx-auto w-50">
                    {% else %}
                        Sin imagen
                    {% endif %}
                </td>
                <td>{{ image.name }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
