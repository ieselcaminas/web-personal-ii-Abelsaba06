{% extends 'base.html.twig' %}
{% block body %}
    <figure>
    <div class="image-overlay">
    </div>
    <img src="{{ asset('images/index/gallery/' ~ image.file) }}" alt="{{ image.file }}" class="img-fluid d-block mx-auto w-50">
    </figure>
    <p>Likes {{image.likes}}</p>
    <p><a href="{{ path('comentarios', {'id': image.id}) }}">
        <button>Comentarios</button>
    </a>{{ image.comments|length }}</p>
{{ include ('page/form_comment.html.twig') }}
{% endblock %}