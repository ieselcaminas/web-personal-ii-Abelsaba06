{% extends 'base.html.twig' %}

{% block title %}Gallery{% endblock %}

{% block body %}
   <form class="" action='{{ path('gallery_buscar') }}'>
   <input type="text" class="form-control" style="display:unset; width:85%" placeholder="Buscar" name='searchTerm'>
   <button type='submit' class="btn btn-primary btn-lime"><i class="fa fa-search"></i>
   </button>
   </form>
<!-- gallery -->
      <div class="gallery">
         <div class="container">
            <div class="row">
               <div class="col-md-12">
                  <div class="titlepage">
                     <h2>Our <span class="green">gallery</span></h2>
                     <p>here are many variations of passages of Lorem Ipsum available, but the majority have suffer</p>
                  </div>
               </div>
            </div>
            <div class="row">
            <div class="row mt-4">
            <div class="col-md-6 col-sm-6 mx-auto">
                <div class="gallery_text">
                    <div class="galleryh3">
                        <h3>Diseños para el interior de tu casa</h3>
                        <p>Te hacemos una muestra de todos los diseños que te ofrecemos para que el interior de tu casa quede mas reluciente, moderno e innovador que nunca</p>
                    </div>
                </div>
            </div>
            <div class="gallery-grid mt-3">
               {% for image in images.results %}
                <div class="gallery-item">
                    <figure>
                    <div class="image-overlay">
                     </div>
                        <a href="{{ path('imagen',{'id': image.id})}}"><img src="{{ asset('images/index/gallery/' ~ image.file) }}" alt="{{ image.file }}"></a>
                        <button class="like-button" data-image-id="{{ image.id }}"><a href="{{ path('like', {'id':image.id}) }}">Like</a></button>
                    </figure>
                    <button class="comment-button" data-image-id="{{ image.id }}"><a href="{{ path('comentarios',{'id': image.id})}}">Commentarios</a></button>
                </div>
               {% endfor %}
               {% if images.hasToPaginate %}
                  <div class="text-left">
                     <ul class="pagination">
                        {% if app.request.attributes.get('_route') == 'gallery' %}
                           {% if images.hasPreviousPage %}
                              <li class="prev"><a href="{{ path('gallery', {page: images.previousPage}) }}" rel="previous"><i class="fa fw fa-long-arrow-left"></i> Previous</a></li>
                           {% else %}
                              <li class="prev disabled"><span><i class="fa fw fa-arrow-left"></i> Previous </span></li>
                           {% endif %}

                           {% for i in 1..images.lastPage %}
                              {% if i == images.currentPage %}
                                 <li class="active"><span>{{ i }}</span></li>
                              {% else %}
                                 <li><a href="{{ path('gallery', {page: i}) }}">{{ i }}</a></li>
                              {% endif %}
                           {% endfor %}

                           {% if images.hasNextPage %}
                              <li class="next"><a href="{{ path('gallery', {page: images.nextPage}) }}" rel="next">Next <i class="fa fw fa-arrow-right"></i></a></li>
                           {% else %}
                              <li class="next disabled"><span>Next <i class="fa fw fa-arrow-right"></i></span></li>
                           {% endif %}
                        {% else %}
                        {% endif %}
                     </ul>
                  </div>
               {% endif %}
      </div>
{% endblock %}