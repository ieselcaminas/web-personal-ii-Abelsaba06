{% extends 'base.html.twig' %}

{% block title %}Gallery{% endblock %}

{% block body %}
<!-- gallery -->
      <div class="gallery">
         <div class="container">
            <div class="row">
               <div class="col-md-12">
                  <div class="titlepage">
                     <h2>Our <span class="green">gallery</span></h2>
                     <p>here are many variations of passages of Lorem Ipsum available, but the majority have suffer</p>
                  </div>
               </div>
            </div>
            <div class="row">
            <div class="row mt-4">
            <div class="col-md-4 col-sm-6 mx-auto">
                <div class="gallery_text">
                    <div class="galleryh3">
                        <h3>Interior Design</h3>
                        <p>of passages of Lorem 
                           Ipsum available 
                           , but the majority 
                           have suffer
                        </p>
                    </div>
                </div>
            </div>
            <div class="gallery-grid mt-3">
               {% for image in images %}
                <div class="gallery-item">
                    <figure>
                    <div class="image-overlay"></div>
                        <img src="{{ asset('images/index/gallery/' ~ image.file) }}" alt="{{ image.file }}">
                           <button class="like-button" data-image-id="{{ image.id }}">Like</button>
                    </figure>
                </div>
               {% endfor %}
</div>
{% endblock %}